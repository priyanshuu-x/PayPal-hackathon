# PayPal (sandbox app from the Developer Dashboard)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
VITE_PAYPAL_CLIENT_ID=            # sandbox client ID for JS SDK v6 (public by design)
PAYPAL_SDK_DOMAINS=               # optional, comma-separated, for the JS SDK v6 client token

# AI
GROQ_API_KEY=
GROQ_MODEL_VISION=qwen/qwen3.8-27b                              # extraction (needs image input)
GROQ_MODEL_TEXT=openai/gpt-oss-120b                           # drafting and Copilot (tool calling)
COPILOT_MAX_TOOL_CALLS=5

# AG Grid / AG Studio (trial license; injected at build time, never committed)
VITE_AG_STUDIO_LICENSE_KEY=

# Render
DATABASE_URL=sqlite:///./proofcheck.db
RENDER_WORKFLOWS_ENABLED=false
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=

# App
UPLOAD_DIR=./data/uploads
# SESSION_SECRET: at least 32 random characters (login is disabled without it)
SESSION_SECRET=
DEMO_MERCHANT_EMAIL=
# Generate with:  python -m app.security.auth  (run inside backend/)
DEMO_MERCHANT_PASSWORD_HASH=
STORE_NAMES=Lotus & Loom Demo Store
DAILY_LLM_CALL_CAP=500
RETENTION_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=true
DEMO_MODE=false
RATE_LIMIT_ENABLED=true
# Number of reverse proxies in front of the API (Render: 1). 0 means trust the socket IP only.
TRUSTED_PROXY_COUNT=0

# Stretch only
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=
ZAPIER_MCP_URL=
